{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cstd-alpha-assistant-deep-research",
  "main": "index.ts",
  "compatibility_date": "2026-05-10",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "REPORT_CACHE",
      "id": "d2c77bf9e7f14258af33e2efd3f59c60"
    }
  ],
  "d1_databases": [
    {
      "binding": "REPORT_LIBRARY_DB",
      "database_name": "cstd-alpha-report-library",
      "database_id": "3eb99167-0083-4510-924c-66735e4be407"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORT_LIBRARY_BUCKET",
      "bucket_name": "cstd-alpha-report-library"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "cstd-alpha-assistant-deep-research",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "retry_delay": 30,
        "max_concurrency": 2
      }
    ]
  }
}
