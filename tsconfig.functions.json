{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["functions/api/**/*.ts", "functions/_shared/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
